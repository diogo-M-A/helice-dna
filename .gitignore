# Lista positiva: apenas código, referências de coordenadas e exemplos sintéticos.
# Genótipos, relatórios, caches, arquivos temporários e downloads não são versionados.
*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/iniciar.cmd
!/server.py
!/genetics.py
!/clinical.py
!/catalog.py
!/ancestry.py
!/ancestry_projection.py
!/THIRD_PARTY_NOTICES.md
!/data/
!/data/markers.json
!/web/
!/web/index.html
!/web/app.js
!/web/style.css
!/tools/
!/tools/*.py
!/tests/
!/tests/*.py
!/tests/*.cjs
!/examples/
!/examples/exemplo_sintetico.txt
!/examples/exemplo_sintetico.vcf
!/docs/
!/docs/USAGE.md
!/docs/VALIDATION.md
!/docs/RESEARCH_ROADMAP.md
!/docs/images/
!/docs/images/interface.jpg
!/.github/
!/.github/workflows/
!/.github/workflows/checks.yml
